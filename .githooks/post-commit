#!/bin/sh

branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null)"

if [ "$branch" != "main" ]; then
  echo "Auto-push skipped: current branch is '$branch', not 'main'."
  exit 0
fi

if ! git rev-parse --abbrev-ref --symbolic-full-name "@{u}" >/dev/null 2>&1; then
  echo "Auto-push skipped: branch '$branch' has no upstream remote."
  exit 0
fi

echo "Auto-pushing '$branch' to its upstream remote..."

if ! git push; then
  echo "Auto-push failed. The commit was created locally; open GitHub Desktop and click 'Push origin'." >&2
fi

exit 0
